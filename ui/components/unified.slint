import { ThemeColors } from "../theme.slint";
import { DiffLine, TextSpan } from "../structs.slint";

component CommentLine inherits Rectangle {
    in property <ThemeColors> theme;
    in property <DiffLine> line;

    background: theme.comment-bg;
    clip: true;

    // Left border indicator
    Rectangle {
        x: 0;
        y: 0;
        width: 4px;
        height: 100%;
        background: line.comment-is-reply ? theme.comment-border : theme.comment-author;
    }

    VerticalLayout {
        padding-left: line.comment-is-reply ? 32px : 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;

        // Author and timestamp header
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Text {
                text: line.comment-author;
                color: theme.comment-author;
                font-size: 12px;
                font-weight: 600;
            }

            Text {
                text: line.comment-timestamp;
                color: theme.comment-timestamp;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        // Comment body with word wrap
        Text {
            text: line.comment-body;
            color: theme.comment-body;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

component UnifiedLine inherits Rectangle {
    in property <ThemeColors> theme;
    in property <DiffLine> line;
    in property <length> font-size: 13px;
    in property <length> old-gutter-w: 50px;
    in property <length> new-gutter-w: 50px;

    background: line.line-type == "add" ? theme.diff-add-bg :
                line.line-type == "remove" ? theme.diff-remove-bg :
                line.line-type == "hunk" ? theme.diff-hunk-bg :
                theme.diff-context-bg;

    HorizontalLayout {
        // Gutter - old line number
        Rectangle {
            width: root.old-gutter-w;
            background: line.line-type == "add" ? theme.diff-add-gutter :
                        line.line-type == "remove" ? theme.diff-remove-gutter :
                        theme.bg-secondary;

            Text {
                text: line.old-line-num;
                color: theme.text-muted;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
                x: 0;
                width: parent.width - 8px;
                height: 100%;
            }
        }

        // Gutter - new line number
        Rectangle {
            width: root.new-gutter-w;
            background: line.line-type == "add" ? theme.diff-add-gutter :
                        line.line-type == "remove" ? theme.diff-remove-gutter :
                        theme.bg-secondary;

            // Subtle separator
            Rectangle {
                x: 0;
                width: 1px;
                background: theme.border-subtle;
            }

            Text {
                text: line.new-line-num;
                color: theme.text-muted;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
                x: 0;
                width: parent.width - 8px;
                height: 100%;
            }
        }

        // Sign column
        Rectangle {
            width: 24px;

            Text {
                text: line.is-continuation ? " " :
                      line.line-type == "add" ? "+" :
                      line.line-type == "remove" ? "-" : " ";
                color: line.line-type == "add" ? theme.diff-add-text :
                       line.line-type == "remove" ? theme.diff-remove-text :
                       line.line-type == "hunk" ? theme.diff-hunk-text :
                       theme.text-muted;
                font-size: root.font-size;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                height: 100%;
            }
        }

        // Code content - render spans with syntax highlighting
        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            HorizontalLayout {
                x: 8px;
                // Center the span strip as a block within the row. Setting
                // height:100% + vertical-alignment:center on the individual
                // Texts clips their glyph tops inside a layout; positioning the
                // content-sized strip with y centers cleanly without clipping.
                y: (parent.height - self.height) / 2;
                alignment: start;
                spacing: 0px;

                // Render syntax-highlighted spans if available
                for span in line.spans: Text {
                    text: span.text;
                    color: span.color;
                    font-size: root.font-size;
                    font-family: "monospace";
                }

                // Fallback to plain content when no spans (e.g., hunk headers)
                if line.spans.length == 0: Text {
                    text: line.content;
                    color: line.line-type == "add" ? theme.diff-add-text :
                           line.line-type == "remove" ? theme.diff-remove-text :
                           line.line-type == "hunk" ? theme.diff-hunk-text :
                           theme.text-primary;
                    font-size: root.font-size;
                    font-family: "monospace";
                }
            }
        }
    }
}

component LineItem inherits Rectangle {
    in property <ThemeColors> theme;
    in property <DiffLine> line;
    in property <length> font-size: 13px;
    in property <length> old-gutter-w: 50px;
    in property <length> new-gutter-w: 50px;
    in property <bool> context-expandable: true;
    // Viewport-relative right edge. Rows are as wide as the horizontally
    // scrollable viewport, so anchoring the hint to the row would park it far
    // off-screen; this keeps it against the visible edge as the view scrolls.
    in property <length> hint-right: 0;
    callback expand-context();

    property <bool> is-hunk-header: root.line.line-type == "hunk";

    // Line height scales with font size (1.7x multiplier)
    height: line.line-type == "comment" ? 80px : root.font-size * 1.7;

    CommentLine {
        theme: root.theme;
        line: root.line;
        visible: root.line.line-type == "comment";
        width: 100%;
        height: 100%;
    }

    UnifiedLine {
        theme: root.theme;
        line: root.line;
        font-size: root.font-size;
        old-gutter-w: root.old-gutter-w;
        new-gutter-w: root.new-gutter-w;
        visible: root.line.line-type != "comment";
        width: 100%;
        height: 100%;
    }

    // A hunk header is the boundary of what's shown, so it's the natural place
    // to ask for more. Overlaid last so it wins hit-testing over the row.
    if root.is-hunk-header && root.context-expandable: Rectangle {
        width: 100%;
        height: 100%;
        background: hunk-touch.has-hover ? theme.accent-primary.with-alpha(0.12) : transparent;

        Text {
            x: root.hint-right - self.width;
            text: "+ more context";
            color: hunk-touch.has-hover ? theme.accent-primary : theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
            height: 100%;
        }

        hunk-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expand-context(); }
        }
    }
}

export component UnifiedView inherits Rectangle {
    in property <ThemeColors> theme;
    in property <[DiffLine]> lines;
    in property <int> old-gutter-digits: 0;
    in property <int> new-gutter-digits: 0;
    in property <length> font-size: 13px;
    in-out property <length> scroll-position: 0;
    in property <length> scroll-step: 60px;
    in property <bool> context-expandable: true;
    callback expand-context();

    // Content-sized gutters: ~9px per digit (safe for the 12px number font) plus
    // padding; 0 digits collapses the column entirely (e.g. old col on a new file).
    property <length> old-gutter-w: root.old-gutter-digits <= 0 ? 0px : root.old-gutter-digits * 9px + 8px;
    property <length> new-gutter-w: root.new-gutter-digits <= 0 ? 0px : root.new-gutter-digits * 9px + 8px;

    background: theme.bg-primary;

    flickable := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: max(self.width, 2000px);
        viewport-y <=> root.internal-viewport-y;

        VerticalLayout {
            for line in lines: LineItem {
                theme: root.theme;
                line: line;
                font-size: root.font-size;
                old-gutter-w: root.old-gutter-w;
                new-gutter-w: root.new-gutter-w;
                width: parent.width;
                context-expandable: root.context-expandable;
                hint-right: -flickable.viewport-x + flickable.width - 12px;
                expand-context => { root.expand-context(); }
            }
        }
    }

    // Internal property for two-way binding with flickable
    property <length> internal-viewport-y: -root.scroll-position;

    // Sync scroll-position when internal-viewport-y changes (user scrolling)
    changed internal-viewport-y => {
        root.scroll-position = -root.internal-viewport-y;
    }

    // Sync internal-viewport-y when scroll-position changes (keyboard nav)
    changed scroll-position => {
        root.internal-viewport-y = -root.scroll-position;
    }
}
