import { ScrollView } from "std-widgets.slint";
import { ThemeColors } from "../theme.slint";
import { DiffLine, Ribbon } from "../structs.slint";
import { UnifiedView } from "unified.slint";
import { SideBySideView } from "side_by_side.slint";
import { FlowingView } from "flowing.slint";

export component DiffView inherits Rectangle {
    in property <ThemeColors> theme;
    // "unified", "side-by-side", or "flowing".
    in property <string> view-mode: "unified";
    in property <string> selected-file;
    in property <[DiffLine]> lines: [];
    in property <int> old-gutter-digits: 0;
    in property <int> new-gutter-digits: 0;
    in property <length> font-size: 13px;
    in-out property <length> scroll-position: 0;
    in property <length> scroll-step: 60px;
    in property <bool> viewed: false;
    // Flowing view: rows/ribbons come from Rust; left-y/right-y are written by
    // the remap callback and flow back down here.
    in property <[DiffLine]> flowing-left-rows: [];
    in property <[DiffLine]> flowing-right-rows: [];
    in property <[Ribbon]> flowing-ribbons: [];
    in property <length> flowing-total-virt: 0;
    in property <length> flowing-row-height: 22px;
    in property <length> flowing-comment-height: 80px;
    in property <length> flowing-left-y: 0;
    in property <length> flowing-right-y: 0;
    callback flowing-remap(/* virtual-y */ length);
    // Selectable plain-text mode: swaps the rendered diff for a read-only,
    // monospace TextInput so text can be dragged-to-select and copied (Ctrl+C).
    // Native Slint Text isn't selectable; TextInput is.
    in property <bool> select-mode: false;
    in property <string> selectable-text: "";
    // How much unchanged code surrounds each change, e.g. "±3 lines".
    in property <string> context-level-label: "";
    in property <bool> context-expandable: true;

    callback toggle-viewed();
    // Mark one change segment viewed, or expand it again. Raised by the toggle
    // on the segment's first row and by clicking a collapsed segment's bar.
    callback toggle-segment-viewed(/* segment index */ int);
    // Widen the context by one rung. Raised by the header control and by
    // clicking any hunk header.
    callback expand-context();
    // Asks the parent to leave select mode (it owns the select-mode property
    // and the keyboard focus that must return to the main view).
    callback exit-select();

    background: theme.bg-primary;

    // Reset scroll when file changes
    property <string> prev-selected-file: "";
    changed selected-file => {
        if (root.selected-file != root.prev-selected-file) {
            root.scroll-position = 0;
            root.prev-selected-file = root.selected-file;
        }
    }

    if selected-file == "": Rectangle {
        width: 100%;
        height: 100%;
        // Empty state
        VerticalLayout {
            alignment: center;

            Text {
                text: "Select a file to view diff";
                color: theme.text-muted;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }
    }

    if selected-file != "": VerticalLayout {
        width: 100%;
        height: 100%;

        // File header bar (styled like a hunk header)
        Rectangle {
            height: root.font-size * 1.7;
            background: theme.diff-hunk-bg;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                Text {
                    text: root.selected-file;
                    color: theme.diff-hunk-text;
                    font-size: root.font-size;
                    font-family: "monospace";
                    vertical-alignment: center;
                }

                // Context width + viewed checkbox
                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;

                    // Current context width, doubling as an expand button. Keeps
                    // the "+ does nothing now" case legible: at the top rung the
                    // label reads "whole file" and the control goes inert.
                    Rectangle {
                        width: ctx-label.preferred-width + 16px;
                        y: (parent.height - self.height) / 2;
                        height: root.font-size * 1.4;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: ctx-touch.has-hover && root.context-expandable
                            ? theme.accent-primary : theme.border-normal;
                        background: ctx-touch.has-hover && root.context-expandable
                            ? theme.accent-primary.with-alpha(0.15) : transparent;

                        ctx-label := Text {
                            text: root.context-expandable
                                ? root.context-level-label + "  +"
                                : root.context-level-label;
                            color: root.context-expandable ? theme.text-primary : theme.text-muted;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        ctx-touch := TouchArea {
                            mouse-cursor: root.context-expandable ? pointer : default;
                            clicked => {
                                if (root.context-expandable) {
                                    root.expand-context();
                                }
                            }
                        }
                    }

                    Text {
                        text: "Viewed";
                        color: root.viewed ? theme.status-added : theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 16px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.viewed ? theme.status-added : theme.border-normal;
                        background: root.viewed ? theme.status-added.with-alpha(0.2) : transparent;

                        Text {
                            text: root.viewed ? "✓" : "";
                            color: theme.status-added;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-viewed(); }
                        }
                    }
                }
            }

            // Bottom border
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: theme.border-subtle;
            }
        }

        if !root.select-mode && root.view-mode == "unified": UnifiedView {
            vertical-stretch: 1;
            theme: root.theme;
            lines: root.lines;
            old-gutter-digits: root.old-gutter-digits;
            new-gutter-digits: root.new-gutter-digits;
            font-size: root.font-size;
            scroll-position <=> root.scroll-position;
            scroll-step: root.scroll-step;
            context-expandable: root.context-expandable;
            expand-context => { root.expand-context(); }
            toggle-segment-viewed(idx) => { root.toggle-segment-viewed(idx); }
        }

        if !root.select-mode && root.view-mode == "side-by-side": SideBySideView {
            vertical-stretch: 1;
            theme: root.theme;
            lines: root.lines;
            old-gutter-digits: root.old-gutter-digits;
            new-gutter-digits: root.new-gutter-digits;
            font-size: root.font-size;
            scroll-position <=> root.scroll-position;
            scroll-step: root.scroll-step;
            context-expandable: root.context-expandable;
            expand-context => { root.expand-context(); }
            toggle-segment-viewed(idx) => { root.toggle-segment-viewed(idx); }
        }

        if !root.select-mode && root.view-mode == "flowing": FlowingView {
            vertical-stretch: 1;
            theme: root.theme;
            left-rows: root.flowing-left-rows;
            right-rows: root.flowing-right-rows;
            ribbons: root.flowing-ribbons;
            old-gutter-digits: root.old-gutter-digits;
            new-gutter-digits: root.new-gutter-digits;
            font-size: root.font-size;
            row-height: root.flowing-row-height;
            comment-height: root.flowing-comment-height;
            total-virt: root.flowing-total-virt;
            left-y: root.flowing-left-y;
            right-y: root.flowing-right-y;
            scroll-position <=> root.scroll-position;
            scroll-step: root.scroll-step;
            context-expandable: root.context-expandable;
            remap(v) => { root.flowing-remap(v); }
            expand-context => { root.expand-context(); }
            toggle-segment-viewed(idx) => { root.toggle-segment-viewed(idx); }
        }

        // Selectable plain-text mode
        if root.select-mode: VerticalLayout {
            vertical-stretch: 1;

            // Banner: hint + exit affordance
            Rectangle {
                height: root.font-size * 1.7;
                background: theme.diff-hunk-bg;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: space-between;

                    Text {
                        text: "Select mode · drag to select · Ctrl+C to copy";
                        color: theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: exit-label.preferred-width + 16px;
                        y: (parent.height - self.height) / 2;
                        height: root.font-size * 1.4;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: exit-touch.has-hover ? theme.accent-primary : theme.border-normal;
                        background: exit-touch.has-hover ? theme.accent-primary.with-alpha(0.15) : transparent;

                        exit-label := Text {
                            text: "Exit (Esc)";
                            color: theme.text-primary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        exit-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.exit-select(); }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: theme.border-subtle;
                }
            }

            // Read-only monospace TextInput inside a ScrollView. Mirrors the
            // composition Slint's own TextEdit uses (ScrollView + TextInput with
            // page-height), so drag-to-select and scroll don't fight each other.
            sel-scroll := ScrollView {
                vertical-stretch: 1;
                content-width: max(self.visible-width, sel-input.preferred-width + 16px);
                content-height: max(self.visible-height, sel-input.preferred-height + 8px);

                sel-input := TextInput {
                    x: 8px;
                    y: 4px;
                    text: root.selectable-text;
                    read-only: true;
                    single-line: false;
                    wrap: no-wrap;
                    font-family: "monospace";
                    font-size: root.font-size;
                    color: theme.text-primary;
                    selection-background-color: theme.accent-primary;
                    selection-foreground-color: theme.bg-primary;
                    page-height: sel-scroll.visible-height;

                    // Escape leaves select mode even while the TextInput holds
                    // focus (it would otherwise swallow the key). Other keys fall
                    // through so copy/selection/navigation keep working.
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.exit-select();
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }
    }
}
