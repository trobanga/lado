import { ThemeColors } from "../theme.slint";
import { Typography } from "../typography.slint";

component ToolbarButton inherits Rectangle {
    in property <ThemeColors> theme;
    in property <string> label;
    in property <bool> active: false;

    callback clicked;

    width: self.height * 2.5;
    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? theme.bg-hover : (active ? theme.bg-tertiary : transparent);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        Text {
            text: label;
            color: active ? theme.text-primary : theme.text-secondary;
            font-size: Typography.label;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Segment of the 3-way view toggle. Active when the current mode matches `mode`.
component ViewToggleSegment inherits Rectangle {
    in property <ThemeColors> theme;
    in property <string> label;
    in property <string> mode;
    in property <string> view-mode;
    callback pick(string);

    property <bool> active: root.view-mode == root.mode;

    background: root.active ? theme.bg-hover : transparent;
    border-radius: 3px;

    Text {
        text: root.label;
        color: root.active ? theme.text-primary : theme.text-muted;
        font-size: Typography.caption;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (!root.active) { root.pick(root.mode); }
        }
    }
}

component ViewToggle inherits Rectangle {
    in property <ThemeColors> theme;
    in property <string> view-mode;
    callback set-mode(string);

    height: 28px;
    width: 220px;
    background: theme.bg-tertiary;
    border-radius: 4px;

    HorizontalLayout {
        padding: 2px;

        ViewToggleSegment {
            theme: root.theme;
            label: "Unified";
            mode: "unified";
            view-mode: root.view-mode;
            pick(m) => { root.set-mode(m); }
        }

        ViewToggleSegment {
            theme: root.theme;
            label: "Side by Side";
            mode: "side-by-side";
            view-mode: root.view-mode;
            pick(m) => { root.set-mode(m); }
        }

        ViewToggleSegment {
            theme: root.theme;
            label: "Flowing";
            mode: "flowing";
            view-mode: root.view-mode;
            pick(m) => { root.set-mode(m); }
        }
    }
}

export component Toolbar inherits Rectangle {
    in property <ThemeColors> theme;
    in property <string> view-mode;
    in property <string> diff-title;
    in property <int> files-changed: 0;
    in property <int> total-additions: 0;
    in property <int> total-deletions: 0;

    callback set-mode(string);
    callback refresh;
    callback open-settings;

    height: 48px;
    background: theme.bg-secondary;

    // Bottom border
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: theme.border-subtle;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: space-between;

        // Left section - title
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            Text {
                text: "lado";
                color: theme.accent-primary;
                font-size: Typography.wordmark;
                font-weight: Typography.semibold;
                letter-spacing: 0.3px;
                vertical-alignment: center;
            }

            Rectangle {
                width: 1px;
                height: 20px;
                background: theme.border-normal;
            }

            Text {
                text: diff-title;
                color: theme.text-primary;
                font-size: Typography.title;
                font-weight: Typography.medium;
                vertical-alignment: center;
            }
        }

        // Right section - controls
        HorizontalLayout {
            spacing: 12px;
            alignment: end;

            // Overall diff summary: files changed + total +/-
            if files-changed > 0: HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Text {
                    text: files-changed + (files-changed == 1 ? " file" : " files");
                    color: theme.text-muted;
                    font-size: Typography.caption;
                    vertical-alignment: center;
                }

                if total-additions > 0: Text {
                    text: "+" + total-additions;
                    color: theme.status-added;
                    font-size: Typography.caption;
                    vertical-alignment: center;
                }

                if total-deletions > 0: Text {
                    text: "-" + total-deletions;
                    color: theme.status-deleted;
                    font-size: Typography.caption;
                    vertical-alignment: center;
                }
            }

            if files-changed > 0: Rectangle {
                width: 1px;
                height: 20px;
                background: theme.border-normal;
            }

            ViewToggle {
                theme: root.theme;
                view-mode: root.view-mode;
                set-mode(m) => { root.set-mode(m); }
            }

            ToolbarButton {
                theme: root.theme;
                label: "Refresh";
                clicked => { root.refresh(); }
            }

            // Settings gear button
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: settings-touch.has-hover ? theme.bg-hover : transparent;

                Text {
                    text: "⚙";
                    color: theme.text-secondary;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                settings-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-settings(); }
                }
            }
        }
    }
}
