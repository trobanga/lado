// Per-change-segment "viewed" controls, shared by the unified, side-by-side and
// flowing views.
//
// A change segment is one maximal run of removed and added lines — the unit a
// reviewer marks as read. Rust tags every row with the index of the segment it
// belongs to, and flags the rows of a marked segment with segment-viewed:
//
//   SegmentToggle — overlays the first row of a segment and marks or unmarks
//                   it. Modelled on the hunk expander, so the diff stays quiet
//                   until the pointer is over a segment.
//   Fade          — the colours of a marked segment's rows. The code stays on
//                   screen, drained of saturation.

import { ThemeColors } from "../theme.slint";
import { DiffLine } from "../structs.slint";

// How much colour saturation a viewed row keeps.
export global Fade {
    // `c` with its saturation cut when `faded`. Hue and brightness stay, so
    // an added and a removed row still differ, only quieter.
    public pure function tone(c: color, faded: bool) -> color {
        if (!faded) {
            return c;
        }
        return hsv(c.to-hsv().hue, c.to-hsv().saturation * 0.2, c.to-hsv().value, c.to-hsv().alpha);
    }
}

// Hover affordance on the first row of a segment. On a viewed segment it stays
// visible, as the mark, and a click clears it.
export component SegmentToggle inherits Rectangle {
    in property <ThemeColors> theme;
    in property <DiffLine> line;
    // Viewport-relative right edge. Rows are as wide as the horizontally
    // scrollable viewport, so anchoring to the row would park the label far
    // off-screen; this keeps it against the visible edge as the view scrolls.
    in property <length> hint-right: 0;
    callback toggle();

    width: 100%;
    height: 100%;
    background: touch.has-hover ? theme.accent-primary.with-alpha(0.12) : transparent;

    Text {
        x: root.hint-right - self.width;
        text: root.line.segment-viewed && touch.has-hover ? "✗ unmark" : "✓ viewed";
        color: touch.has-hover ? theme.accent-primary : theme.text-muted;
        font-size: 11px;
        vertical-alignment: center;
        height: 100%;
        // An unviewed segment only announces itself under the pointer: a
        // persistent label on every change block would compete with the code.
        opacity: touch.has-hover || root.line.segment-viewed ? 1.0 : 0.0;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
}
