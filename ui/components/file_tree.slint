import { ThemeColors } from "../theme.slint";
import { FileEntry } from "../structs.slint";
import { Icon } from "icon.slint";
import { Typography } from "../typography.slint";

// File status indicator
component StatusBadge inherits Rectangle {
    in property <ThemeColors> theme;
    in property <string> status; // "added", "modified", "deleted"

    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: status == "added" ? theme.status-added :
                status == "deleted" ? theme.status-deleted :
                theme.status-modified;
}

// Added / removed line counts (files show their own, folders the descendant sum)
component DiffStat inherits HorizontalLayout {
    in property <ThemeColors> theme;
    in property <int> additions;
    in property <int> deletions;

    spacing: 5px;
    alignment: center;

    if additions > 0: Text {
        text: "+" + additions;
        color: theme.status-added;
        font-size: Typography.caption;
        vertical-alignment: center;
    }

    if deletions > 0: Text {
        text: "-" + deletions;
        color: theme.status-deleted;
        font-size: Typography.caption;
        vertical-alignment: center;
    }
}

// Comment count indicator
component CommentBadge inherits HorizontalLayout {
    in property <ThemeColors> theme;
    in property <int> count;

    spacing: 2px;
    alignment: center;

    Text {
        text: "\u{1f4ac}";
        font-size: 10px;
        vertical-alignment: center;
    }

    Text {
        text: count;
        color: theme.comment-author;
        font-size: 10px;
        vertical-alignment: center;
    }
}

// Individual file/folder item
component TreeItem inherits Rectangle {
    in property <ThemeColors> theme;
    in property <string> name;
    in property <string> path;
    in property <int> depth;
    in property <bool> is-folder;
    in property <bool> is-expanded: true;
    in property <string> status: "modified";
    in property <int> comment-count: 0;
    in property <bool> selected: false;
    in property <bool> focused: false;
    in property <bool> viewed: false;
    in property <int> additions: 0;
    in property <int> deletions: 0;

    callback clicked;
    callback toggle-expand;
    callback toggle-viewed;

    height: 28px;
    // Single coherent treatment: a subtle fill for any active row and one left
    // accent bar that doubles as the position indicator — no full border.
    background: selected ? theme.bg-selected :
                (focused || touch.has-hover) ? theme.bg-hover :
                transparent;

    // Left edge bar: solid+thick when selected, thin+translucent for keyboard
    // focus, absent otherwise. Distinguishes the two states without a border.
    Rectangle {
        x: 0;
        y: 0;
        width: selected ? 3px : (focused ? 2px : 0);
        height: parent.height;
        background: theme.accent-primary;
        opacity: selected ? 1.0 : (focused ? 0.55 : 0.0);
    }

    // Row-level click handler — declared before the HorizontalLayout so that
    // inner per-cell TouchAreas (folder expand, viewed checkbox) sit on top
    // in z-order and receive clicks first.
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.is-folder) {
                root.toggle-expand();
            } else {
                root.clicked();
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px + (depth * 16px);
        padding-right: 12px;
        spacing: 8px;
        alignment: start;

        // Expand/collapse chevron for folders
        if is-folder: Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;

            Icon {
                kind: is-expanded ? "chevron-down" : "chevron-right";
                icon-color: theme.text-muted;
                size: 14px;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle-expand(); }
            }
        }

        // Files have no chevron — reserve its slot so file icons stay aligned
        // under folder icons (chevron width 16px + layout spacing 8px).
        if !is-folder: Rectangle {
            width: 16px;
            height: 16px;
        }

        // File / folder type icon
        Icon {
            y: (parent.height - self.height) / 2;
            size: 16px;
            kind: is-folder ? (is-expanded ? "folder-open" : "folder") : "file";
            icon-color: is-folder ? theme.accent-secondary : theme.text-muted;
        }

        // Viewed checkbox for files
        if !is-folder: Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            border-width: 1px;
            border-color: viewed ? theme.status-added : theme.border-normal;
            background: viewed ? theme.status-added.with-alpha(0.2) : transparent;

            Text {
                text: viewed ? "✓" : "";
                color: theme.status-added;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle-viewed(); }
            }
        }

        // Name
        Text {
            text: name;
            color: viewed ? theme.text-muted :
                   selected ? theme.text-primary : theme.text-secondary;
            font-size: Typography.body;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle { }

        // Added/removed counts (files and aggregated folders)
        if additions > 0 || deletions > 0: DiffStat {
            theme: root.theme;
            additions: root.additions;
            deletions: root.deletions;
        }

        // Comment count badge for files with comments
        if !is-folder && comment-count > 0: CommentBadge {
            theme: root.theme;
            count: root.comment-count;
        }

        // Status badge for files
        if !is-folder: StatusBadge {
            theme: root.theme;
            status: root.status;
        }
    }
}

export component FileTree inherits Rectangle {
    in property <ThemeColors> theme;
    in-out property <string> selected-file;
    in property <[FileEntry]> files: [];
    in property <int> focused-index: -1;

    callback file-clicked(/* path */ string, /* index */ int);
    callback folder-toggled(/* path */ string);
    callback viewed-toggled(/* index */ int);

    background: transparent;

    VerticalLayout {
        padding-top: 8px;

        // Header
        Rectangle {
            height: 40px;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: start;

                Text {
                    text: "CHANGED FILES";
                    color: theme.text-secondary;
                    font-size: Typography.section;
                    font-weight: Typography.semibold;
                    letter-spacing: Typography.section-tracking;
                    vertical-alignment: center;
                }
            }
        }

        // File list
        Flickable {
            vertical-stretch: 1;
            content-height: files.length * 28px;

            VerticalLayout {
                for file[idx] in files: TreeItem {
                    theme: root.theme;
                    name: file.name;
                    path: file.path;
                    depth: file.depth;
                    is-folder: file.is-folder;
                    is-expanded: file.is-expanded;
                    status: file.status;
                    comment-count: file.comment-count;
                    viewed: file.viewed;
                    additions: file.additions;
                    deletions: file.deletions;
                    selected: file.path == selected-file;
                    focused: idx == root.focused-index;

                    clicked => {
                        if (!file.is-folder) {
                            root.file-clicked(file.path, idx);
                        }
                    }

                    toggle-expand => {
                        root.folder-toggled(file.path);
                    }

                    toggle-viewed => {
                        root.viewed-toggled(idx);
                    }
                }
            }
        }
    }
}
