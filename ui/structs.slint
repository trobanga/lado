// Shared data structures
export struct TextSpan {
    text: string,
    color: color,
}

export struct FileEntry {
    name: string,
    path: string,
    depth: int,
    is-folder: bool,
    is-expanded: bool,
    status: string,
    comment-count: int,
    viewed: bool,
    additions: int,
    deletions: int,
}

export struct CommitEntry {
    sha: string,
    short-sha: string,
    summary: string,
    author: string,
}

// One ribbon connector for the flowing diff view, in content-space y coords.
// Rust fills these from the FlowLayout change segments (collapsing an empty side
// to a thin seam band); the overlay subtracts each pane's live offset to place
// them, and derives the translucent fill from the empty flags + theme.
export struct Ribbon {
    left-top: length,
    left-bottom: length,
    right-top: length,
    right-bottom: length,
    left-empty: bool,   // pure insertion: no removed lines (arm crosses left pane)
    right-empty: bool,  // pure deletion: no added lines (arm crosses right pane)
}

export struct DiffLine {
    line-type: string,      // "add", "remove", "context", "hunk", "comment", "seg-bar"
    old-line-num: string,
    new-line-num: string,
    content: string,
    spans: [TextSpan],      // Syntax-highlighted text segments
    is-continuation: bool,  // True for wrap-continuation rows: no line num, no sign
    // Comment fields (empty for non-comments)
    comment-author: string,
    comment-body: string,
    comment-timestamp: string,
    comment-is-reply: bool,
    comment-side: string,   // "left" or "right"; drives one-sided rendering
    // Change-segment fields. A change segment is one maximal run of removed and
    // added rows, and is the unit a reviewer marks as viewed. Rust tags the rows
    // of each segment here; the views turn the tags into a toggle.
    segment-index: int,        // index into the file's segment list; -1 = none
    segment-first: bool,       // first row of an un-collapsed segment: shows the toggle
    segment-additions: int,    // rows the segment adds (for the collapsed bar)
    segment-deletions: int,    // rows the segment removes (for the collapsed bar)
}
